FROM edoburu/pgbouncer:latest

# Base image runs as USER postgres (non-root): escalate for apk,
# then drop back. postgresql-client only for the pg_isready
# container healthcheck.
USER root
RUN apk add --no-cache postgresql-client
USER postgres

COPY --chown=postgres:postgres --chmod=600 docker/pgbouncer/pgbouncer.ini /etc/pgbouncer/pgbouncer.ini
COPY --chown=postgres:postgres --chmod=600 docker/pgbouncer/userlist.txt /etc/pgbouncer/userlist.txt
