package views

templ StatCard(label string, value string, sub string) {
	<div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
		<div class="text-xs font-medium uppercase tracking-wide text-zinc-500">{ label }</div>
		<div class="mt-1 text-2xl font-semibold tabular-nums">{ value }</div>
		if sub != "" {
			<div class="mt-0.5 text-xs text-zinc-500">{ sub }</div>
		}
	</div>
}

templ StatCards(stats Stats) {
	<div id="stat-cards" hx-get="/partials/stats" hx-trigger="every 5s" hx-swap="outerHTML" class="grid grid-cols-2 gap-3 md:grid-cols-4">
		@StatCard("Pending", Num(stats.Pending), Num(stats.Queued)+" queued")
		@StatCard("Processing", Num(stats.Processing), Num(stats.Workers)+" workers")
		@StatCard("Scheduled", Num(stats.Scheduled), "recurring + delayed")
		@StatCard("Failed", Num(stats.Failed), "dead-letter queue")
		@StatCard("Completed", Num(stats.Completed), "")
		@StatCard("Cancelled", Num(stats.Cancelled), "")
		@StatCard("Queue depth", Num(stats.QueueDepth), "stream entries")
		@StatCard("Oldest pending", Age(stats.OldestAgeSec), "head-of-line wait")
	</div>
}

templ StatsError() {
	<div id="stat-cards" hx-get="/partials/stats" hx-trigger="every 5s" hx-swap="outerHTML" class="rounded-lg border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-300">
		Stats unavailable — retrying…
	</div>
}

templ JobRow(job Job) {
	<tr class="border-t border-zinc-800 hover:bg-zinc-900/60">
		<td class="px-3 py-2 font-mono text-xs text-zinc-400" title={ job.ID }>{ ShortID(job.ID) }</td>
		<td class="px-3 py-2 text-sm">{ job.Type }</td>
		<td class="px-3 py-2"><span class={ StatusBadge(job.Status) }>{ job.Status }</span></td>
		<td class="px-3 py-2 text-sm tabular-nums text-zinc-400">{ Num(int64(job.Attempt)) }/{ Num(int64(job.MaxRetry)) }</td>
		<td class="px-3 py-2 text-sm text-zinc-400">{ job.Queue }</td>
		<td class="px-3 py-2 text-xs text-zinc-500">{ job.CreatedAt }</td>
		<td class="px-3 py-2 text-right">
			<a href={ "/jobs/" + job.ID } class="text-sm text-emerald-400 hover:text-emerald-300">View</a>
		</td>
	</tr>
}

templ JobTable(jobs []Job, filter JobFilter) {
	<div id="job-table" hx-get={ "/partials/jobs?" + filter.Query() } hx-trigger="every 15s" hx-swap="outerHTML">
		<div class="overflow-hidden rounded-lg border border-zinc-800">
			<table class="w-full border-collapse">
				<thead>
					<tr class="bg-zinc-900 text-left text-xs uppercase tracking-wide text-zinc-500">
						<th class="px-3 py-2 font-medium">ID</th>
						<th class="px-3 py-2 font-medium">Type</th>
						<th class="px-3 py-2 font-medium">Status</th>
						<th class="px-3 py-2 font-medium">Try</th>
						<th class="px-3 py-2 font-medium">Queue</th>
						<th class="px-3 py-2 font-medium">Created</th>
						<th class="px-3 py-2 font-medium"><span class="sr-only">Open</span></th>
					</tr>
				</thead>
				<tbody>
					for _, job := range jobs {
						@JobRow(job)
					}
					if len(jobs) == 0 {
						<tr>
							<td colspan="7" class="px-3 py-8 text-center text-sm text-zinc-500">No jobs match this filter.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="mt-3 flex items-center justify-between text-sm">
			<div class="text-zinc-500">Showing { Num(int64(len(jobs))) } · offset { Num(int64(filter.Offset)) }</div>
			<div class="flex gap-2">
				if filter.Offset > 0 {
					<a href={ "/?" + filter.WithOffset(max(filter.Offset-filter.Limit, 0)).Query() } class="rounded-md bg-zinc-800 px-3 py-1.5 text-zinc-300 hover:bg-zinc-700">← Prev</a>
				}
				if filter.HasMore {
					<a href={ "/?" + filter.WithOffset(filter.Offset+filter.Limit).Query() } class="rounded-md bg-zinc-800 px-3 py-1.5 text-zinc-300 hover:bg-zinc-700">Next →</a>
				}
			</div>
		</div>
	</div>
}

templ JobsError() {
	<div id="job-table" class="rounded-lg border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-300">
		Jobs unavailable — <a href="/" class="underline">reload</a>.
	</div>
}

templ Dashboard(stats Stats, jobs []Job, filter JobFilter, notice string) {
	@Layout("Dashboard", true) {
		<div class="mb-4 flex items-center justify-between">
			<h1 class="text-xl font-semibold">Dashboard</h1>
			<a href="/jobs/new" class="rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-500">+ New job</a>
		</div>
		if notice != "" {
			<div class="mb-4 rounded-md bg-amber-500/10 px-3 py-2 text-sm text-amber-300 ring-1 ring-amber-500/30">{ notice }</div>
		}
		@StatCards(stats)
		<div class="mt-6 mb-3 flex flex-wrap items-center gap-2">
			for _, tab := range FilterTabs {
				if tab == filter.Status {
					<a href={ tabLink(tab, filter) } class={ TabClass(true) }>
						if tab == "" {
							All
						} else {
							{ tab }
						}
					</a>
				} else {
					<a href={ tabLink(tab, filter) } class={ TabClass(false) }>
						if tab == "" {
							All
						} else {
							{ tab }
						}
					</a>
				}
			}
			<form method="GET" action="/" class="ml-auto flex gap-2">
				<input name="series_id" value={ filter.SeriesID } placeholder="series id…" class="w-40 rounded-md border border-zinc-700 bg-zinc-800 px-2 py-1.5 font-mono text-xs placeholder-zinc-500 focus:border-emerald-500 focus:outline-none"/>
				<button type="submit" class="rounded-md bg-zinc-800 px-3 py-1.5 text-sm text-zinc-300 hover:bg-zinc-700">Series</button>
				if filter.SeriesID != "" {
					<a href="/" class="rounded-md bg-zinc-800 px-3 py-1.5 text-sm text-zinc-300 hover:bg-zinc-700">Clear</a>
				}
			</form>
		</div>
		@JobTable(jobs, filter)
	}
}
