package views

templ Login(email string, errMsg string) {
	@Layout("Login", false) {
		<div class="mx-auto mt-16 max-w-md rounded-lg border border-zinc-800 bg-zinc-900 p-6">
			<h1 class="text-xl font-semibold">Login</h1>
			<p class="mt-1 text-sm text-zinc-400">Session is cookie-based; the token never reaches JS.</p>
			if errMsg != "" {
				<div class="mt-4 rounded-md bg-red-500/10 px-3 py-2 text-sm text-red-300 ring-1 ring-red-500/30">{ errMsg }</div>
			}
			<form method="POST" action="/login" class="mt-4 space-y-4">
				<div>
					<label for="email" class="block text-sm font-medium text-zinc-300">Email</label>
					<input id="email" name="email" type="email" required value={ email } autocomplete="email"
						class="mt-1 w-full rounded-md border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none"/>
				</div>
				<div>
					<label for="password" class="block text-sm font-medium text-zinc-300">Password</label>
					<input id="password" name="password" type="password" required autocomplete="current-password"
						class="mt-1 w-full rounded-md border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none"/>
				</div>
				<button type="submit" class="w-full rounded-md bg-emerald-600 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-500">Login</button>
			</form>
			<p class="mt-4 text-center text-sm text-zinc-400">No account? <a href="/register" class="text-emerald-400 hover:text-emerald-300">Register</a></p>
		</div>
	}
}

templ Register(name string, email string, errMsg string) {
	@Layout("Register", false) {
		<div class="mx-auto mt-16 max-w-md rounded-lg border border-zinc-800 bg-zinc-900 p-6">
			<h1 class="text-xl font-semibold">Register</h1>
			<p class="mt-1 text-sm text-zinc-400">Creates a user and logs you in.</p>
			if errMsg != "" {
				<div class="mt-4 rounded-md bg-red-500/10 px-3 py-2 text-sm text-red-300 ring-1 ring-red-500/30">{ errMsg }</div>
			}
			<form method="POST" action="/register" class="mt-4 space-y-4">
				<div>
					<label for="name" class="block text-sm font-medium text-zinc-300">Name</label>
					<input id="name" name="name" type="text" required value={ name } autocomplete="username"
						class="mt-1 w-full rounded-md border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none"/>
				</div>
				<div>
					<label for="email" class="block text-sm font-medium text-zinc-300">Email</label>
					<input id="email" name="email" type="email" required value={ email } autocomplete="email"
						class="mt-1 w-full rounded-md border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none"/>
				</div>
				<div>
					<label for="password" class="block text-sm font-medium text-zinc-300">Password (min 8 chars)</label>
					<input id="password" name="password" type="password" required minlength="8" autocomplete="new-password"
						class="mt-1 w-full rounded-md border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none"/>
				</div>
				<button type="submit" class="w-full rounded-md bg-emerald-600 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-500">Register</button>
			</form>
			<p class="mt-4 text-center text-sm text-zinc-400">Have an account? <a href="/login" class="text-emerald-400 hover:text-emerald-300">Login</a></p>
		</div>
	}
}
